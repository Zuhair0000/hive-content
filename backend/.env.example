# Port the Express server listens on (defaults to 3001)
PORT=3001

# PostgreSQL host (e.g. localhost or your Supabase host)
DB_HOST=your_db_host

# PostgreSQL user
DB_USER=your_db_user

# PostgreSQL password
DB_PASSWORD=your_db_password

# PostgreSQL database name
DB_NAME=your_db_name

# PostgreSQL port (5432 by default)
DB_PORT=5432

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Gemini model used to generate content plans (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Frontend origin allowed by CORS (e.g. http://localhost:5173)
FRONTEND_API_URL=http://localhost:5173

# Secret used to sign JWTs; use a long random string
JWT_SECRET=change_me_to_a_long_random_string
